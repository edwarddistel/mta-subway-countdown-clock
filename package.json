{
  "name": "mta-subway-countdown-clock",
  "version": "2.0.0",
  "private": true,
  "description": "An always-on NYC subway arrival board, built for the browser and Raspberry Pi.",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "lint": "node scripts/check.js",
    "check": "npm run lint && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edwarddistel/mta-countdown-clock.git"
  },
  "author": "Edward Distel",
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {}
}
